{
  "name": "Destination",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Destination or route name"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "gateway_lat": {
      "type": "number",
      "description": "Latitude of the primary gateway city for travel-practicality estimates"
    },
    "gateway_lng": {
      "type": "number",
      "description": "Longitude of the primary gateway city for travel-practicality estimates"
    },
    "internal_access_penalty": {
      "type": "number",
      "description": "Approximate hours of onward/ground travel normally needed beyond the gateway",
      "default": 0
    },
    "connection_hours": {
      "type": "number",
      "description": "Expected one-way connection time in hours",
      "default": 0
    },
    "travel_mode": {
      "type": "string",
      "description": "Curated indicative access mode for display"
    },
    "primary_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Two to three signature interests that define the destination"
    },
    "strong_months": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "shoulder_months": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "min_days": {
      "type": "integer"
    },
    "max_days": {
      "type": "integer"
    },
    "budget_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interest_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "climate_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pace_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activity_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traveller_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dietary_notes": {
      "type": "string"
    },
    "currency_code": {
      "type": "string",
      "description": "ISO 4217 currency code (e.g. EUR, USD)"
    },
    "currency_name": {
      "type": "string",
      "description": "Full currency name (e.g. Euro, US dollar)"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Official or commonly encountered languages a tourist will see and hear"
    },
    "plug_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Electrical plug/socket types commonly found (e.g. C, F, G, A, B)"
    },
    "voltage": {
      "type": "string",
      "description": "Mains voltage at the gateway (e.g. 230V, 120V); some countries use dual voltage"
    },
    "emergency_number": {
      "type": "array",
      "description": "Emergency numbers by service; single entry with service 'Emergency' for unified numbers, multiple entries where numbers differ by service",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "number"
        ]
      }
    },
    "connectivity_note": {
      "type": "string",
      "description": "One-sentence factual note on eSIM / local SIM availability and coverage"
    },
    "top_experiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seasonal_packing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "day_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "morning": {
            "type": "string"
          },
          "afternoon": {
            "type": "string"
          },
          "evening": {
            "type": "string"
          },
          "food_note": {
            "type": "string"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "intensity": {
            "type": "string"
          },
          "flexible": {
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "description": "Optional concise activity label shown instead of an auto-truncated title"
          },
          "optional_swap": {
            "type": "string",
            "description": "Optional per-template swap suggestion shown in the Optional swap section"
          },
          "signature": {
            "type": "boolean",
            "default": false,
            "description": "Flag this day template as a signature/flagship experience; signature days are always included in the itinerary before tag-overlap scoring fills the remaining budget"
          }
        }
      }
    },
    "best_for_summary": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "country",
    "region"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}